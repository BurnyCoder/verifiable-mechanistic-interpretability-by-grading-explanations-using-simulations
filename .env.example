# .env.example — every setting the pipeline reads, with safe defaults. Copy to .env and edit.
# Global context: src/vmi/config.py loads .env with python-dotenv; .env itself is git-ignored.

# --- storage (large files live outside the repo) ---
VMI_DATA_DIR=D:/AI/vmi-sim/data            # downloaded target runs and the paper checkpoint
VMI_MODELS_DIR=D:/AI/vmi-sim/models        # GGUF files for llama-server
VMI_RUNS_DIR=D:/AI/vmi-sim/runs            # one folder per agent run (sandbox, transcript, weights)
HF_HOME=D:/AI/vmi-sim/hf_cache             # Hugging Face cache

# --- pinned sources (fixed before any result exists) ---
VMI_HF_RUNS_REPO=BurnyCoder/grokking-modular-addition-runs
VMI_HF_RUNS_REVISION=                       # commit hash, filled in by `vmi pin`
VMI_PAPER_REPO=callummcdougall/grokking_full_run_data

# --- local LLM server (llama.cpp llama-server on Windows) ---
VMI_LLAMA_SERVER=D:/AI/vmi-sim/llama.cpp/llama-server.exe
VMI_LLM_PORT=8080
VMI_LLM_MODEL=qwen3.6-35b-a3b
VMI_LLM_GGUF=D:/AI/vmi-sim/models/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf
VMI_LLM_CONTEXT=65536
VMI_LLM_TEMPERATURE=0.6

# --- agent run limits ---
VMI_RUN_TIMEOUT_S=2400
VMI_RUN_MAX_STEPS=60

# --- Anthropic credentials: NOT used by this project (Claude Code work is postponed) ---
# ANTHROPIC_API_KEY=
